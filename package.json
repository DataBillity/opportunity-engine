{
  "name": "opportunity-engine",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "go": "powershell -NoProfile -ExecutionPolicy Bypass -File ./go.ps1",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "pnpm --filter @opportunity-engine/db generate",
    "db:migrate": "pnpm --filter @opportunity-engine/db migrate",
    "db:push": "pnpm --filter @opportunity-engine/db push",
    "db:seed": "pnpm --filter @opportunity-engine/db seed",
    "ingest:linkedin": "pnpm --filter @opportunity-engine/worker ingest:linkedin"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
