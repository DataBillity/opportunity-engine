# System of Record (Layer 1) — Neon project opportunity-engine (dawn-wildflower-13103198)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Redis (Layer 4 - Orchestration)
REDIS_URL=redis://localhost:6379

# AI Gateway (Layer 5 - Intelligence)
# Required for AI-powered outreach and RFP/SOW extraction. Claude is the primary
# writer; Gemini is the extraction-tier model and fallback writer. Add both, then
# restart `pnpm --filter @opportunity-engine/web dev`. Without keys, RFP ingest
# still parses and scores with the heuristic triage.
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_AI_API_KEY=...
CLOUDFLARE_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/...

# Cloudflare (Layer 3 - Edge)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=opportunity-engine
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Auth (Layer 8 - Identity)
# Shared production gate — in-app sign-in at /login
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Langfuse (Layer 6 - Observability)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=http://localhost:3040

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3100
NODE_ENV=development
