# System of Record (Layer 1)
DATABASE_URL=postgresql://user:password@host:5432/opportunity_engine
DIRECT_DATABASE_URL=postgresql://user:password@host:5432/opportunity_engine

# Redis (Layer 4 - Orchestration)
REDIS_URL=redis://localhost:6379

# AI Gateway (Layer 5 - Intelligence)
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_AI_API_KEY=...
CLOUDFLARE_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/...

# Cloudflare (Layer 3 - Edge)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=opportunity-engine
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Auth (Layer 8 - Identity)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Langfuse (Layer 6 - Observability)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=http://localhost:3040

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3100
NODE_ENV=development
